      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify((({ http_status, api_base_url, ...rest }) => rest)($node[\"Format Error\"].json)) }}",
        "options": {
          "responseCode": "={{ $node[\"Format Error\"].json.http_status }}"
        }
      },
      "id": "a1b2c3d4-0000-4000-8000-000000000014",
      "name": "Respond - Error",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        1120,
        300
      ]
    }
