          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $node[\"Validate Upload\"].json.api_key }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ case_id: $json.case_id }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "id": "a1b2c3d4-0000-4000-8000-000000000005",
      "name": "2. Sanctions Screening",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
