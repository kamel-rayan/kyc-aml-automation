# Copy to .env (or export) — every value is optional except the API key for Claude mode.
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_MODEL=claude-sonnet-4-5        # check docs.claude.com/en/docs/about-claude/models for current IDs
KYC_AI_MODE=auto                       # auto | claude | offline
KYC_API_PORT=8000
KYC_API_KEY=                           # if set, clients must send X-API-Key
SANCTIONS_MATCH_THRESHOLD=0.90
SANCTIONS_POTENTIAL_THRESHOLD=0.80
KYC_LOG_LEVEL=INFO
