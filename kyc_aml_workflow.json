{
  "name": "KYC/AML Automation Workflow",
  "nodes": [
    {
      "parameters": {
        "content": "## KYC / AML Automation\nPOST a KYC document (PDF/PNG/JPG) as multipart field **document** to the webhook.\n\n**Happy path:** Validate → Extract (Claude) → Sanctions screen → Risk classify → Report → (Escalate if review needed) → JSON response.\n\n**Error path:** any stage failure → Format Error → audit log → error response.\n\nEdit `API_BASE` in **Validate Upload** to point at `api_server.py`.",
        "height": 260,
        "width": 520,
        "color": 4
      },
      "id": "a1b2c3d4-0000-4000-8000-000000000001",
      "name": "Sticky Note",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -200,
        -340
      ]
    },
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "kyc-aml",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "a1b2c3d4-0000-4000-8000-000000000002",
      "name": "Webhook - Receive KYC Document",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -200,
        0
      ],
      "webhookId": "5f1d8c2e-6c7a-4b8e-9d2f-0a1b2c3d4e5f"
    },
    {
      "parameters": {
        "jsCode": "// ---- Configuration (single place to edit) ----\nconst API_BASE = 'http://localhost:8000';   // where api_server.py runs\nconst API_KEY  = '';                         // set if KYC_API_KEY is configured on the API\nconst ALLOWED  = ['application/pdf', 'image/png', 'image/jpeg', 'image/webp'];\n\nconst item = $input.first();\nconst keys = Object.keys(item.binary || {});\nif (keys.length === 0) {\n  throw new Error('No file uploaded. Send multipart/form-data with a file in field \"document\".');\n}\n// Prefer the field named \"document\", otherwise take the first uploaded file\nconst key = keys.includes('document') ? 'document' : keys[0];\nconst bin = item.binary[key];\nif (!ALLOWED.includes(bin.mimeType)) {\n  throw new Error(`Unsupported file type ${bin.mimeType}. Allowed: ${ALLOWED.join(', ')}`);\n}\n\nreturn [{\n  json: {\n    api_base_url: API_BASE,\n    api_key: API_KEY,\n    execution_id: $execution.id,\n    received_at: new Date().toISOString(),\n    file_name: bin.fileName,\n    mime_type: bin.mimeType,\n  },\n  binary: { document: bin },\n  pairedItem: { item: 0 },\n}];"
      },
      "id": "a1b2c3d4-0000-4000-8000-000000000003",
      "name": "Validate Upload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        20,
        0
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $node[\"Validate Upload\"].json.api_base_url }}/api/v1/parse",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-API-Key",
              "value": "={{ $node[\"Validate Upload\"].json.api_key }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "parameterType": "formBinaryData",
              "name": "document",
              "inputDataFieldName": "document"
            },
            {
              "name": "channel",
              "value": "n8n"
            }
          ]
        },
        "options": {
          "timeout": 120000
        }
      },
      "id": "a1b2c3d4-0000-4000-8000-000000000004",
      "name": "1. Extract KYC Data",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        240,
        0
      ],
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 2000,
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $node[\"Validate Upload\"].json.api_base_url }}/api/v1/screen",
        "sendHeaders": true,
