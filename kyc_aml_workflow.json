        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ case_id: $json.case_id, actor: 'n8n', action: 'WORKFLOW_ERROR', details: { failed_stage: $json.failed_stage, error: $json.error, execution_id: $json.execution_id } }) }}",
        "options": {
          "timeout": 10000
        }
      },
      "id": "a1b2c3d4-0000-4000-8000-000000000013",
      "name": "Log Error to Audit Trail",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        900,
        300
      ],
      "onError": "continueRegularOutput"
    },
